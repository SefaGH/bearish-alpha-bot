  "identity": {
    "principalId": "2fe71d92-14ab-408b-ac6e-61d63a1899f7",
    "tenantId": "f52d191d-6ba4-4217-a625-3a0696356c9f",
    "type": "SystemAssigned"
  },
  "location": "westeurope",
  "name": "bearish-bot-stop-core",
  "properties": {
    "accessEndpoint": "https://prod-211.westeurope.logic.azure.com:443/workflows/d291eb860ee741218123f1658e3dd3b5",
    "changedTime": "2025-12-17T18:11:13.2985312Z",
    "createdTime": "2025-12-15T17:08:55.9313137Z",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "actions": {
        "Acquire_Lock": {
          "inputs": {
            "authentication": {
              "audience": "https://storage.azure.com/",
              "type": "ManagedServiceIdentity"
            },
            "headers": {
              "x-ms-date": "@{formatDateTime(utcNow(),'r')}",
              "x-ms-lease-action": "acquire",
              "x-ms-lease-duration": "60",
              "x-ms-version": "2019-02-02"
            },
            "method": "PUT",
            "uri": "https://bearishstorage.blob.core.windows.net/locks/runcommand.lock?comp=lease"
          },
          "runAfter": {
            "Validate_And_Default_Inputs": [
              "Succeeded"
            ]
          },
          "type": "Http"
        },
        "Critical_Section": {
          "actions": {
            "If_Running_Stop_Container": {
              "actions": {
                "Until_Stop_Container": {
                  "actions": {
                    "Compose_StatusCode_Stop": {
                      "inputs": "@int(coalesce(actions('Stop_Container')?['outputs']?['statusCode'], 0))",
                      "runAfter": {
                        "Stop_Container": [
                          "Succeeded",
                          "Failed"
                        ]
                      },
                      "type": "Compose"
                    },
                    "If_Conflict_Delay_Stop": {
                      "actions": {
                        "Delay_Stop": {
                          "inputs": {
                            "interval": {
                              "count": 10,
                              "unit": "Second"
                            }
                          },
                          "type": "Wait"
                        }
                      },
                      "else": {
                        "actions": {}
                      },
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@outputs('Compose_StatusCode_Stop')",
                              409
                            ]
                          }
                        ]
                      },
                      "runAfter": {
                        "Compose_StatusCode_Stop": [
                          "Succeeded"
                        ]
                      },
                      "type": "If"
                    },
                    "Stop_Container": {
                      "inputs": {
                        "authentication": {
                          "audience": "https://management.azure.com",
                          "type": "ManagedServiceIdentity"
                        },
                        "body": {
                          "commandId": "RunShellScript",
                          "script": [
                            "set -e",
                            "NAME=\"@{parameters('containerName')}\"",
                            "TIMEOUT=\"@{string(outputs('Validate_And_Default_Inputs')['timeoutSeconds'])}\"",
                            "",
                            "# 1. FLAG OLUSTUR (Parent App icin)",
                            "echo \"MANUAL_STOP_REQUESTED\" | sudo tee /tmp/bearish_bot_manual_stop.flag > /dev/null",
                            "sudo chmod 777 /tmp/bearish_bot_manual_stop.flag",
                            "",
                            "echo \"=== GRACEFUL STOP PROCEDURE ===\"",
                            "echo \"Checking for live_trading_launcher.py inside container $NAME...\"",
                            "",
                            "# 2. PID BUL VE SIGTERM GONDER",
                            "LAUNCHER_PID=\"$(sudo docker top \"$NAME\" -eo pid,args 2>/dev/null | awk '/live_trading_launcher\\.py/ {print $1; exit}')\"",
                            "echo \"LauncherPID=$LAUNCHER_PID\"",
                            "",
                            "if [ -n \"$LAUNCHER_PID\" ]; then",
                            "  echo \"Found launcher PID=$LAUNCHER_PID. Sending SIGTERM (Graceful Stop)...\"",
                            "  sudo kill -TERM \"$LAUNCHER_PID\" || true",
                            "  ",
                            "  echo \"Waiting up to $TIMEOUT seconds for launcher to exit...\"",
                            "  elapsed=0",
                            "  while [ $elapsed -lt \"$TIMEOUT\" ]; do",
                            "    if ! sudo docker top \"$NAME\" -eo pid,args 2>/dev/null | grep -q 'live_trading_launcher\\.py'; then",
                            "      echo \"Launcher process exited gracefully after ${elapsed}s.\"",
                            "      break",
                            "    fi",
                            "    sleep 2",
                            "    elapsed=$((elapsed+2))",
                            "  done",
                            "else",
                            "  echo \"Launcher PID not found via docker top. Process might have already exited.\"",
                            "fi",
                            "",
                            "# 3. DOCKER STOP (GUVENLIK AGI)",
                            "echo \"=== STOP_CORE: docker stop finalizer ===\"",
                            "echo \"Finalizing container stop (timeout=10s)...\"",
                            "sudo docker stop -t 10 \"$NAME\" || true",
                            "",
                            "# 4. DURUMU RAPORLA",
                            "echo \"Diagnostics:\"",
                            "sudo docker inspect -f 'Status={{.State.Status}} ExitCode={{.State.ExitCode}} FinishedAt={{.State.FinishedAt}}' \"$NAME\" 2>/dev/null || true"
                          ]
                        },
                        "headers": {
                          "Content-Type": "application/json"
                        },
                        "method": "POST",
                        "retryPolicy": {
                          "type": "none"
                        },
                        "uri": "@concat('https://management.azure.com/subscriptions/', parameters('subscriptionId'), '/resourceGroups/', parameters('vmResourceGroup'), '/providers/Microsoft.Compute/virtualMachines/', parameters('vmName'), '/runCommand?api-version=2024-07-01')"
                      },
                      "limit": {
                        "timeout": "PT2M"
                      },
                      "type": "Http"
                    }
                  },
                  "expression": "@not(equals(outputs('Compose_StatusCode_Stop'), 409))",
                  "limit": {
                    "count": 10,
                    "timeout": "PT5M"
                  },
                  "runAfter": {
                    "Wait_Before_Stop": [
                      "Succeeded"
                    ]
                  },
                  "type": "Until"
                },
                "Wait_Before_Stop": {
                  "inputs": {
                    "interval": {
                      "count": 5,
                      "unit": "Second"
                    }
                  },
                  "type": "Wait"
                }
              },
              "else": {
                "actions": {}
              },
              "expression": {
                "equals": [
                  "@toLower(outputs('Parse_Container_Status'))",
                  "running"
                ]
              },
              "runAfter": {
                "Parse_Container_Status": [
                  "Succeeded"
                ]
              },
              "type": "If"
            },
            "Parse_Container_Status": {
              "inputs": "@if(equals(outputs('Check_Container_Status')?['statusCode'], 200), trim(split(split(body('Check_Container_Status')?['value']?[0]?['message'], '[stdout]')[1], '[stderr]')[0]), 'error')",
              "runAfter": {
                "Until_Check_Container_Status": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              },
              "type": "Compose"
            },
            "Parse_Final_Status": {
              "inputs": "@if(equals(outputs('Verify_Final_Status')?['statusCode'], 200), trim(split(split(body('Verify_Final_Status')?['value']?[0]?['message'], '[stdout]')[1], '[stderr]')[0]), 'error')",
              "runAfter": {
                "Until_Verify_Final_Status": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              },
              "type": "Compose"
            },
            "Return_Result": {
              "inputs": {
                "body": {
                  "correlationId": "@outputs('Validate_And_Default_Inputs')['correlationId']",
                  "finalContainerStatus": "@outputs('Parse_Final_Status')",
                  "initialContainerStatus": "@outputs('Parse_Container_Status')",
                  "reason": "@outputs('Validate_And_Default_Inputs')['reason']",
                  "requestedBy": "@outputs('Validate_And_Default_Inputs')['requestedBy']",
                  "status": "ok",
                  "timeoutSeconds": "@outputs('Validate_And_Default_Inputs')['timeoutSeconds']",
                  "timestamp": "@utcNow()"
                },
                "headers": {
                  "Content-Type": "application/json"
                },
                "statusCode": 200
              },
              "kind": "Http",
              "runAfter": {
                "Send_Stop_Email": [
                  "Succeeded",
                  "Failed",
                  "Skipped"
                ]
              },
              "type": "Response"
            },
            "Send_Stop_Email": {
              "inputs": {
                "body": {
                  "content": {
                    "html": "@concat('Correlation: ', outputs('Validate_And_Default_Inputs')['correlationId'], '<br/>Reason: ', outputs('Validate_And_Default_Inputs')['reason'], '<br/>InitialStatus: ', outputs('Parse_Container_Status'), '<br/>FinalStatus: ', outputs('Parse_Final_Status'), '<br/>Time: ', utcNow())",
                    "subject": "@concat(' Bearish Bot: Stop Requested (', outputs('Validate_And_Default_Inputs')['requestedBy'], ') - Final: ', outputs('Parse_Final_Status'))"
                  },
                  "importance": "High",
                  "recipients": {
                    "to": [
                      {
                        "address": "@parameters('notification_recipient_email')"
                      }
                    ]
                  },
                  "senderAddress": "@parameters('sender_email_address')"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['acsemail']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/emails:sendGAVersion",
                "queries": {
                  "api-version": "2023-03-31"
                }
              },
              "runAfter": {
                "Parse_Final_Status": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection"
            },
            "Until_Check_Container_Status": {
              "actions": {
                "Check_Container_Status": {
                  "inputs": {
                    "authentication": {
                      "audience": "https://management.azure.com",
                      "type": "ManagedServiceIdentity"
                    },
                    "body": {
                      "commandId": "RunShellScript",
                      "script": [
                        "set -e",
                        "NAME=\"@{parameters('containerName')}\"",
                        "status=$(sudo docker inspect -f '{{.State.Status}}' \"$NAME\" 2>/dev/null || echo 'not_found')",
                        "if [ \"$status\" = \"running\" ]; then",
                        "  echo \"running\"",
                        "else",
                        "  echo \"$status\"",
                        "fi"
                      ]
                    },
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "method": "POST",
                    "retryPolicy": {
                      "type": "none"
                    },
                    "uri": "@concat('https://management.azure.com/subscriptions/', parameters('subscriptionId'), '/resourceGroups/', parameters('vmResourceGroup'), '/providers/Microsoft.Compute/virtualMachines/', parameters('vmName'), '/runCommand?api-version=2024-07-01')"
                  },
                  "limit": {
                    "timeout": "PT2M"
                  },
                  "type": "Http"
                },
                "Compose_StatusCode_Check": {
                  "inputs": "@int(coalesce(actions('Check_Container_Status')?['outputs']?['statusCode'], 0))",
                  "runAfter": {
                    "Check_Container_Status": [
                      "Succeeded",
                      "Failed"
                    ]
                  },
                  "type": "Compose"
                },
                "If_Conflict_Delay_Check": {
                  "actions": {
                    "Delay_Check": {
                      "inputs": {
                        "interval": {
                          "count": 10,
                          "unit": "Second"
                        }
                      },
                      "type": "Wait"
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@outputs('Compose_StatusCode_Check')",
                          409
                        ]
                      }
                    ]
                  },
                  "runAfter": {
                    "Compose_StatusCode_Check": [
                      "Succeeded"
                    ]
                  },
                  "type": "If"
                }
              },
              "expression": "@not(equals(outputs('Compose_StatusCode_Check'), 409))",
              "limit": {
                "count": 10,
                "timeout": "PT5M"
              },
              "type": "Until"
            },
            "Until_Verify_Final_Status": {
              "actions": {
                "Compose_StatusCode_Verify": {
                  "inputs": "@int(coalesce(actions('Verify_Final_Status')?['outputs']?['statusCode'], 0))",
                  "runAfter": {
                    "Verify_Final_Status": [
                      "Succeeded",
                      "Failed"
                    ]
                  },
                  "type": "Compose"
                },
                "If_Conflict_Delay_Verify": {
                  "actions": {
                    "Delay_Verify": {
                      "inputs": {
                        "interval": {
                          "count": 10,
                          "unit": "Second"
                        }
                      },
                      "type": "Wait"
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@outputs('Compose_StatusCode_Verify')",
                          409
                        ]
                      }
                    ]
                  },
                  "runAfter": {
                    "Compose_StatusCode_Verify": [
                      "Succeeded"
                    ]
                  },
                  "type": "If"
                },
                "Verify_Final_Status": {
                  "inputs": {
                    "authentication": {
                      "audience": "https://management.azure.com",
                      "type": "ManagedServiceIdentity"
                    },
                    "body": {
                      "commandId": "RunShellScript",
                      "script": [
                        "set -e",
                        "NAME=\"@{parameters('containerName')}\"",
                        "status=$(sudo docker inspect -f '{{.State.Status}}' \"$NAME\" 2>/dev/null || echo 'not_found')",
                        "echo \"$status\""
                      ]
                    },
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "method": "POST",
                    "retryPolicy": {
                      "type": "none"
                    },
                    "uri": "@concat('https://management.azure.com/subscriptions/', parameters('subscriptionId'), '/resourceGroups/', parameters('vmResourceGroup'), '/providers/Microsoft.Compute/virtualMachines/', parameters('vmName'), '/runCommand?api-version=2024-07-01')"
                  },
                  "limit": {
                    "timeout": "PT2M"
                  },
                  "type": "Http"
                }
              },
              "expression": "@not(equals(outputs('Compose_StatusCode_Verify'), 409))",
              "limit": {
                "count": 10,
                "timeout": "PT5M"
              },
              "runAfter": {
                "Wait_Before_Verify": [
                  "Succeeded"
                ]
              },
              "type": "Until"
            },
            "Wait_Before_Verify": {
              "inputs": {
                "interval": {
                  "count": 10,
                  "unit": "Second"
                }
              },
              "runAfter": {
                "If_Running_Stop_Container": [
                  "Succeeded",
                  "Skipped",
                  "Failed",
                  "TimedOut"
                ]
              },
              "type": "Wait"
            }
          },
          "runAfter": {
            "Acquire_Lock": [
              "Succeeded"
            ]
          },
          "type": "Scope"
        },
        "Release_Lock": {
          "inputs": {
            "authentication": {
              "audience": "https://storage.azure.com/",
              "type": "ManagedServiceIdentity"
            },
            "headers": {
              "x-ms-date": "@{formatDateTime(utcNow(),'r')}",
              "x-ms-lease-action": "release",
              "x-ms-lease-id": "@{outputs('Acquire_Lock')['headers']['x-ms-lease-id']}",
              "x-ms-version": "2019-02-02"
            },
            "method": "PUT",
            "uri": "https://bearishstorage.blob.core.windows.net/locks/runcommand.lock?comp=lease"
          },
          "runAfter": {
            "Critical_Section": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "type": "Http"
        },
        "Validate_And_Default_Inputs": {
          "inputs": {
            "correlationId": "@coalesce(triggerBody()?['correlationId'], workflow().run.name)",
            "reason": "@coalesce(triggerBody()?['reason'], 'manual_stop')",
            "requestedBy": "@coalesce(triggerBody()?['requestedBy'], 'unknown')",
            "timeoutSeconds": "@coalesce(triggerBody()?['timeoutSeconds'], parameters('defaultStopTimeoutSeconds'))"
          },
          "runAfter": {},
          "type": "Compose"
        }
      },
      "contentVersion": "1.0.0.0",
