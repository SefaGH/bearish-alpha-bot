{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "🚀 Run Act Test (10min)",
			"type": "shell",
			"command": "${workspaceFolder}/run_act_test.ps1",
			"args": [
				"600"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "dedicated",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": []
		},
		{
			"label": "🚀 Run Act Test (1min - Quick)",
			"type": "shell",
			"command": "${workspaceFolder}/run_act_test.ps1",
			"args": [
				"60"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "dedicated",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": []
		},
		{
			"label": "🚀 Run Act Test (20min)",
			"type": "shell",
			"command": "${workspaceFolder}/run_act_test.ps1",
			"args": [
				"1200"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "dedicated",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": []
		},
		{
			"type": "func",
			"label": "func: host start",
			"command": "host start",
			"problemMatcher": "$func-python-watch",
			"isBackground": true,
			"dependsOn": "pip install (functions)",
			"options": {
				"cwd": "${workspaceFolder}/azure_functions\\reporting"
			}
		},
		{
			"label": "pip install (functions)",
			"type": "shell",
			"osx": {
				"command": "${config:azureFunctions.pythonVenv}/bin/python -m pip install -r requirements.txt"
			},
			"windows": {
				"command": "${config:azureFunctions.pythonVenv}\\Scripts\\python -m pip install -r requirements.txt"
			},
			"linux": {
				"command": "${config:azureFunctions.pythonVenv}/bin/python -m pip install -r requirements.txt"
			},
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}/azure_functions\\reporting"
			}
		},
		{
			"label": "pip check (functions)",
			"type": "shell",
			"osx": {
				"command": "${config:azureFunctions.pythonVenv}/bin/python -m pip check"
			},
			"windows": {
				"command": "${config:azureFunctions.pythonVenv}\\Scripts\\python -m pip check"
			},
			"linux": {
				"command": "${config:azureFunctions.pythonVenv}/bin/python -m pip check"
			},
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}/azure_functions\\reporting"
			}
		},
		{
			"label": "Run PnL staleness report",
			"type": "shell",
			"command": "C:/Users/sefaa/bearish-alpha-bot/.venv/Scripts/python.exe",
			"args": [
				"c:/Users/sefaa/bearish-alpha-bot/scripts/pnl_staleness_report.py"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run PnL staleness report (capture)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"& 'C:/Users/sefaa/bearish-alpha-bot/.venv/Scripts/python.exe' 'c:/Users/sefaa/bearish-alpha-bot/scripts/pnl_staleness_report.py' | Tee-Object -FilePath 'c:/Users/sefaa/bearish-alpha-bot/logs/pnl_staleness_report.txt'"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}