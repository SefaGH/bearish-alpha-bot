# Azure App Service Environment Variables Configuration
# Copy these to your App Service Configuration > Application Settings

# === AZURE APP CONFIGURATION ===
# Required for loading settings from Azure App Configuration (REST API)
AZURE_APPCONFIG_ENDPOINT=https://appcs-bearish-bot.azconfig.io
AZURE_APPCONFIG_LABEL=production

# === TRADING CONFIGURATION ===

TRADING_MODE=paper

DEBUG_MODE=false

ML_ENABLED=true

CONFIG_STRICT_TYPE_CHECK=true

EXCHANGES=bingx

TRADING_DURATION=7200
BINGX_REST_DEBUG=1


# --- AĞ VE RESILIENCE AYARLARI ---

# 1. Timeout (Zaman Aşımı): 10 Saniye
# BingX genelde 1sn içinde cevap verir. 10sn, yavaş internet için güvenli bir sınırdır.
CCXT_TIMEOUT_MS=10000

# 2. Maksimum Deneme: 2 Kere
# İlk deneme başarısız olursa sadece 1 kez daha dene.
# 3 kez denemek döngüyü çok uzatabilir (Worst case: 20+ saniye gecikme).
TICKER_MAX_ATTEMPTS=2

# 3. Cache Süresi: 1 Saniye
# Fiyatı 1 saniye hafızada tut. HFT yapmadığımız için bu süre makul.
TICKER_CACHE_TTL_S=1.0

# 4. Bekleme Süresi: 0.4 Saniye
# Hata alırsan hemen saldırma, biraz bekle (Jitter ile bu süre artacak).
TICKER_RETRY_BASE_DELAY_S=0.4


# === EXCHANGE CREDENTIALS (use secrets) ===

BINGX_KEY=2cPdB7GaD3dRdvHoPe3rCN2rCcmCixlujWq6vhYD7gprATEWDMkSsB0e11aoMc4lW3xGuidO2XtiN6aCEYH4w

BINGX_SECRET=R0WJPPl85RlUdSVkeLuOY94PFuNG2MHiduN3EKYYwFImblzpyT6jjPGzGIEKfgPP2wHzcgBS8NotDgjlvoFKg



# === TELEGRAM NOTIFICATIONS (optional) ===

TELEGRAM_BOT_TOKEN=8430411522:AAEBNktJplfrY4a8b4RSQpGBi4PtjLwXAUw

TELEGRAM_CHAT_ID=1359128753



# === TRADING PARAMETERS ===

CAPITAL_USDT=500

PER_TRADE_RISK_PCT=0.003

DAILY_MAX_TRADES=8

DUPLICATE_PREVENTION_THRESHOLD=0.0005

DUPLICATE_PREVENTION_COOLDOWN=20



# === SYMBOLS AND THRESHOLDS ===

TRADING_SYMBOLS=BTC/USDT:USDT

RSI_THRESHOLD_BTC=50

RSI_THRESHOLD_ETH=50

RSI_THRESHOLD_SOL=50



# === ML CONFIGURATION ===

GEMMA_ENABLED=true

ML_ACTIVE_BUNDLE=artifacts/gemma/final

ML_FEAT_VOL_WINDOWS=5,10,20,50

ML_FEAT_MOM_WINDOWS=5,10,20,50



# === WEBSOCKET LIMITS ===

WS_MAX_STREAMS_BINGX=10



# === PRICE DELTA BYPASS ===

PRICE_DELTA_BYPASS_ENABLED=true

PRICE_DELTA_BYPASS_THRESHOLD=0.0015



# === PYTHON ENVIRONMENT ===

PYTHONUNBUFFERED=1

PYTHONPATH=/home/site/wwwroot:/home/site/wwwroot/src:/home/site/wwwroot/scripts



# === AZURE SPECIFIC ===

# PORT is automatically set by Azure App Service

# SCM_DO_BUILD_DURING_DEPLOYMENT=true



# === LOG LEVEL ===

LOG_LEVEL=INFO

STRATEGY_SHADOW_EVAL=1


# === KEY VAULT (optional) ===

# KEYVAULT_NAME=your-keyvault-name


