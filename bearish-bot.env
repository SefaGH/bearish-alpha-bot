# Azure App Service Environment Variables Configuration
# Copy these to your App Service Configuration > Application Settings
#
# IMPORTANT (secrets hygiene):
# - Do NOT commit real credentials here.
# - Put real credentials in `bearish-bot.env.local` (gitignored) or inject via your secret manager.

# === AZURE APP CONFIGURATION ===
# Required for loading settings from Azure App Configuration (REST API)
AZURE_APPCONFIG_ENDPOINT=https://appcs-bearish-bot.azconfig.io
AZURE_APPCONFIG_LABEL=production

# === EXECUTION MODE ===
# Default remains simulated; real execution requires both TRADING_MODE=live and EXECUTION_BACKEND=ccxt.
TRADING_MODE=live
EXECUTION_BACKEND=ccxt

# BingX environment routing (required when EXECUTION_BACKEND=ccxt + TRADING_MODE=live)
BINGX_ENV=prod

# === STAGE-2 (native conditional stops) feature flags ===
# Default OFF. Enable only for VST canaries until validated in production.
BINGX_NATIVE_HARD_STOP_ENABLED=false
BINGX_NATIVE_TRAILING_ON_ACTIVATION_ENABLED=false

# === TRADING CONFIGURATION ===
DEBUG_MODE=false
ML_ENABLED=true
CONFIG_STRICT_TYPE_CHECK=true

EXCHANGES=bingx
TRADING_DURATION=7200
BINGX_REST_DEBUG=0

# --- AĞ VE RESILIENCE AYARLARI ---
# 1) Timeout (ms)
CCXT_TIMEOUT_MS=10000
# 2) Max attempts
TICKER_MAX_ATTEMPTS=2
# 3) Cache TTL (s)
TICKER_CACHE_TTL_S=1.0
# 4) Base retry delay (s)
TICKER_RETRY_BASE_DELAY_S=0.4

# === EXCHANGE CREDENTIALS (use secrets) ===
BINGX_KEY=CHANGEME
BINGX_SECRET=CHANGEME

# === TELEGRAM NOTIFICATIONS (optional) ===
TELEGRAM_BOT_TOKEN=8430411522:AAEBNktJplfrY4a8b4RSQpGBi4PtjLwXAUw
TELEGRAM_CHAT_ID=1359128753

# === TRADING PARAMETERS ===
CAPITAL_USDT=500
PER_TRADE_RISK_PCT=0.003
DAILY_MAX_TRADES=10
DUPLICATE_PREVENTION_THRESHOLD=0.0005
DUPLICATE_PREVENTION_COOLDOWN=20

# === SYMBOLS AND THRESHOLDS ===
TRADING_SYMBOLS=BTC/USDT:USDT

# === ML CONFIGURATION ===
GEMMA_ENABLED=true
ML_ACTIVE_BUNDLE=artifacts/gemma/final
ML_FEAT_VOL_WINDOWS=5,10,20,50
ML_FEAT_MOM_WINDOWS=5,10,20,50

# === WEBSOCKET LIMITS ===
WS_MAX_STREAMS_BINGX=10

# === PRICE DELTA BYPASS ===
PRICE_DELTA_BYPASS_ENABLED=true
PRICE_DELTA_BYPASS_THRESHOLD=0.0015

# === PYTHON ENVIRONMENT ===
PYTHONUNBUFFERED=1
PYTHONPATH=/home/site/wwwroot:/home/site/wwwroot/src:/home/site/wwwroot/scripts

# === LOG LEVEL ===
LOG_LEVEL=INFO
STRATEGY_SHADOW_EVAL=1

# === KEY VAULT (optional) ===
# KEYVAULT_NAME=bearish-kv
