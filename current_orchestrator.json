{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "actions": {
    "Check_Concurrent_Executions": {
      "inputs": {
        "authentication": {
          "audience": "https://management.azure.com",
          "type": "ManagedServiceIdentity"
        },
        "body": {
          "commandId": "RunShellScript",
          "script": [
            "if docker ps --filter \"name=^bearish-bot$\" --filter \"status=running\" | grep -q \"bearish-bot\"; then echo 'running'; else echo 'not_found'; fi"
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "uri": "https://management.azure.com/subscriptions/74ab10ba-c96d-449e-97cb-ee4f9c0de714/resourceGroups/TradeBot/providers/Microsoft.Compute/virtualMachines/BearishAlphaBot-VM-01/runCommand?api-version=2023-03-01"
      },
      "runAfter": {
        "Send_Initial_Response": [
          "Succeeded"
        ]
      },
      "type": "Http"
    },
    "Guard_Against_Concurrency": {
      "actions": {
        "Send_Concurrency_Warning": {
          "inputs": {
            "body": {
              "content": {
                "html": "<p class=\"editor-paragraph\">Merhaba,<br><br>Yeni bir bot oturumu balatma istei, sistemde halihazrda alan (Running) bir 'bearish-bot' konteyneri tespit edildii iin iptal edilmitir.<br><br>VM Durumu: Aktif Konteyner Bulundu<br><br>Ltfen ilemin bitmesini bekleyin veya acil durumlarda VM zerinden manuel kontrol salayn.<br><br>Tarih: @{utcNow()}</p>",
                "subject": " Bearish Bot: Yeni stek ptal Edildi (akma Tespiti)"
              },
              "importance": "High",
              "recipients": {
                "to": [
                  {
                    "address": "@parameters('notification_recipient_email')"
                  }
                ]
              },
              "senderAddress": "@parameters('sender_email_address')"
            },
            "host": {
              "connection": {
                "name": "@parameters('$connections')['acsemail-1']['connectionId']"
              }
            },
            "method": "post",
            "path": "/emails:sendGAVersion",
            "queries": {
              "api-version": "2023-03-31"
            }
          },
          "type": "ApiConnection"
        },
        "Terminate_Concurrent_Execution": {
          "inputs": {
            "runError": {
              "code": "ConcurrentExecution",
              "message": "Another bot instance is already running. Aborting to prevent concurrent execution."
            },
            "runStatus": "Failed"
          },
          "runAfter": {
            "Send_Concurrency_Warning": [
              "Succeeded"
            ]
          },
          "type": "Terminate"
        }
      },
      "else": {
        "actions": {}
      },
      "expression": {
        "and": [
          {
            "equals": [
              "@or(equals(actions('Check_Concurrent_Executions')?['status'], 'Failed'), contains(string(outputs('Check_Concurrent_Executions')), 'running'))",
              "@true"
            ]
          },
          {
            "equals": [
              "@triggerBody()?['forceRestart']",
              "@false"
            ]
          }
        ]
      },
      "runAfter": {
        "Check_Concurrent_Executions": [
          "Succeeded",
          "TimedOut",
          "Failed"
        ]
      },
      "type": "If"
    },
    "Initialize_Container_Status": {
      "inputs": {
        "variables": [
          {
            "name": "IdempotencyToken",
            "type": "String",
            "value": "@{guid()}"
          },
          {
            "name": "ContainerStatus",
            "type": "string",
            "value": "starting"
          }
        ]
      },
      "runAfter": {
        "Guard_Against_Concurrency": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable"
    },
    "Main_Try_Scope": {
      "actions": {
        "Analyze_Failure_Reason": {
          "inputs": "@if(contains(toLower(string(body('Get_Job_Output_And_Errors'))), 'no space left'), 'DiskFullError', if(contains(toLower(string(body('Get_Job_Output_And_Errors'))), 'error'), 'GeneralScriptError', 'Unknown'))",
          "runAfter": {
            "Get_Job_Output_And_Errors": [
              "Succeeded"
            ]
          },
          "type": "Compose"
        },
        "Build_KeyVault_BaseUri": {
          "inputs": "@concat('https://', parameters('keyVaultName'), '.vault.azure.net')",
          "type": "Compose"
        },
        "Check_Startup_Success": {
          "actions": {
            "Send_Startup_Confirmation_Email": {
              "inputs": {
                "body": {
                  "content": {
                    "html": "Merhaba,<br><br>Bot balatma istei baaryla ilendi ve sanal makine zerinde konteyner (Container) altrld.<br><br> alma Parametreleri<br>--------------------------------------------------<br>Sre: @{triggerBody()?['durationMinutes']} Dakika<br>Zorla Balatma: @{triggerBody()?['forceRestart']}<br>Versiyon (Tag): @{triggerBody()?['imageTag']}<br>Job ID: @{outputs('Get_Job_ID')}<br>--------------------------------------------------<br><br>Bot u an piyasay izliyor. Sre dolduunda veya ilem tamamlandnda detayl analiz raporu gnderilecektir.<br><br>Balang Zaman: @{utcNow()}",
                    "subject": " Bearish Bot: Balatld (Sre: @{triggerBody()?['durationMinutes']} dk)"
                  },
                  "importance": "Normal",
                  "recipients": {
                    "to": [
                      {
                        "address": "@parameters('notification_recipient_email')"
                      }
                    ]
                  },
                  "senderAddress": "@parameters('sender_email_address')"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['acsemail-5']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/emails:sendGAVersion",
                "queries": {
                  "api-version": "2023-03-31"
                }
              },
              "type": "ApiConnection"
            }
          },
          "else": {
            "actions": {
              "Send_Startup_Fail": {
                "inputs": {
                  "body": {
                    "content": {
                      "html": "<p class=\"editor-paragraph\">Merhaba,<br><br>Bot balatma komut dosyas (Runbook) baaryla tamamlanamad. Bot konteyneri balatlmam olabilir.<br><br>Runbook Durumu: @{body('Get_Job_Status')?['properties']?['status']}<br><br>Job ID: @{outputs('Get_Job_ID')}<br><br>Tarih: @{utcNow()}<br><br>Ltfen Azure Automation hesabndaki i kaytlarn (Jobs) inceleyin.</p>",
                      "subject": " Bearish Bot: Balatma Hatas (Runbook Failed)"
                    },
                    "importance": "Normal",
                    "recipients": {
                      "to": [
                        {
                          "address": "@parameters('notification_recipient_email')"
                        }
                      ]
                    },
                    "senderAddress": "@parameters('sender_email_address')"
                  },
                  "host": {
                    "connection": {
                      "name": "@parameters('$connections')['acsemail-2']['connectionId']"
                    }
                  },
                  "method": "post",
                  "path": "/emails:sendGAVersion",
                  "queries": {
                    "api-version": "2023-03-31"
                  }
                },
                "type": "ApiConnection"
              },
              "Terminate_Runbook_Failure": {
                "inputs": {
                  "runError": {
                    "code": "StartupFailed",
                    "message": "Runbook did not complete successfully."
                  },
                  "runStatus": "Failed"
                },
                "runAfter": {
                  "Send_Startup_Fail": [
                    "Succeeded"
                  ]
                },
                "type": "Terminate"
              }
            }
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@body('Get_Job_Status')?['properties']?['status']",
                  "Completed"
                ]
              }
            ]
          },
          "runAfter": {
            "Wait_For_Job_Completion": [
              "Succeeded"
            ]
          },
          "type": "If"
        },
        "Condition_Job_Success": {
          "actions": {
            "Call_Report_Generator": {
              "inputs": {
                "body": {
                  "run_id": "@outputs('Get_Job_ID')"
                },
                "host": {
                  "triggerName": "manual",
                  "workflow": {
                    "id": "/subscriptions/74ab10ba-c96d-449e-97cb-ee4f9c0de714/resourceGroups/tradebot-ops/providers/Microsoft.Logic/workflows/bearish-report-orchestrator",
                    "resourceGroup": "tradebot-ops"
                  }
                }
              },
              "runAfter": {
                "Upload_Raw_Logs_Backup": [
                  "Succeeded",
                  "Failed",
                  "Skipped"
                ]
              },
              "type": "Workflow"
            },
            "Check_Report_Status": {
              "actions": {
                "Send_Report_Email": {
                  "inputs": {
                    "body": {
                      "content": {
                        "html": "<p class=\"editor-paragraph\">@{body('Call_Report_Generator')?['html_report']}</p>",
                        "subject": "@concat(if(equals(outputs('Call_Report_Generator')['statusCode'], 200), ' Bearish Bot: lem Baarl', ' Bearish Bot: Sinyal Analiz Raporu'), ' (Run ID: ', body('Call_Report_Generator')?['run_id'], ')')"
                      },
                      "importance": "Normal",
                      "recipients": {
                        "to": [
                          {
                            "address": "@parameters('notification_recipient_email')"
                          }
                        ]
                      },
                      "senderAddress": "@parameters('sender_email_address')"
                    },
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['acsemail-1']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/emails:sendGAVersion",
                    "queries": {
                      "api-version": "2023-03-31"
                    }
                  },
                  "type": "ApiConnection"
                }
              },
              "else": {
                "actions": {
                  "Send_Report_Error_Email": {
                    "inputs": {
                      "body": {
                        "content": {
                          "html": "<p class=\"editor-paragraph\">Merhaba,<br><br>Raporlama servisi beklenmeyen bir durum kodu dndrd.<br><br>Status Code: @{outputs('Call_Report_Generator')['statusCode']}<br><br>Hata Detay / Sunucu Yant:<br>--------------------------------------------------<br>@{body('Call_Report_Generator')}<br>--------------------------------------------------<br><br>Tarih: @{utcNow()}</p>",
                          "subject": " Bearish Bot: Raporlama Hatas (Status: @{outputs('Call_Report_Generator')['statusCode']})"
                        },
                        "importance": "High",
                        "recipients": {
                          "to": [
                            {
                              "address": "sefaasar@hotmail.com"
                            }
                          ]
                        },
                        "senderAddress": "@parameters('sender_email_address')"
                      },
                      "host": {
                        "connection": {
                          "name": "@parameters('$connections')['acsemail-4']['connectionId']"
                        }
                      },
                      "method": "post",
                      "path": "/emails:sendGAVersion",
                      "queries": {
                        "api-version": "2023-03-31"
                      }
                    },
                    "type": "ApiConnection"
                  }
                }
              },
              "expression": {
                "or": [
                  {
                    "equals": [
                      "@outputs('Call_Report_Generator')['statusCode']",
                      200
                    ]
                  },
                  {
                    "equals": [
                      "@outputs('Call_Report_Generator')['statusCode']",
                      202
                    ]
                  }
                ]
              },
              "runAfter": {
                "Call_Report_Generator": [
                  "Succeeded"
                ]
              },
              "type": "If"
            },
            "Upload_Raw_Logs_Backup": {
              "inputs": {
                "body": {},
                "headers": {
                  "x-functions-key": "@body('Get_LogUploader_Key')?['value']"
                },
                "method": "POST",
                "queries": {
                  "resourceGroup": "TradeBot",
                  "vmName": "BearishAlphaBot-VM-01"
                },
                "timeout": "PT2M",
                "uri": "@parameters('log_uploader_function_url')"
              },
              "type": "Http"
            }
          },
          "else": {
            "actions": {
              "Send_Run_Failure_Email": {
                "inputs": {
                  "body": {
                    "content": {
                      "html": "<p class=\"editor-paragraph\">Merhaba,<br><br>Bot almas srasnda kritik bir hata olutu. Aada hata ile ilgili zet ve ilgili bilgiler yer almaktadr.<br><br>Durum: @{body('Get_Job_Status')?['properties']?['status']}<br><br>Tehis: @{outputs('Analyze_Failure_Reason')}</p><br><p class=\"editor-paragraph\">Output: @{body('Get_Job_Output_And_Errors')}<br><br>Olas Nedenler:<br><br>DiskFullError: Docker disk alan dolmu olabilir.<br><br>GeneralScriptError: Kod veya balant hatas meydana gelmi olabilir.<br><br>Job ID: @{outputs('Get_Job_ID')}</p><br><p class=\"editor-paragraph\">Tarih: @{utcNow()}<br><br>Ltfen container loglarn ve disk durumunu kontrol edin.</p>",
                      "subject": " Bearish Bot Hatas: @{outputs('Analyze_Failure_Reason')}"
                    },
                    "importance": "Normal",
                    "recipients": {
                      "to": [
                        {
                          "address": "@parameters('notification_recipient_email')"
                        }
                      ]
                    },
                    "senderAddress": "@parameters('sender_email_address')"
                  },
                  "host": {
                    "connection": {
                      "name": "@parameters('$connections')['acsemail']['connectionId']"
                    }
                  },
                  "method": "post",
                  "path": "/emails:sendGAVersion",
                  "queries": {
                    "api-version": "2023-03-31"
                  }
                },
                "type": "ApiConnection"
              },
              "Terminate_Bot_Failure": {
                "inputs": {
                  "runError": {
                    "code": "BotExecutionFailed",
                    "message": "The trading bot container exited with errors or did not complete the session successfully. Refer to the failure email for analysis."
                  },
                  "runStatus": "Failed"
                },
                "runAfter": {
                  "Send_Run_Failure_Email": [
                    "Succeeded"
                  ]
                },
                "type": "Terminate"
              }
            }
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@body('Get_Job_Status')?['properties']?['status']",
                  "Completed"
                ]
              }
            ]
          },
          "runAfter": {
            "Analyze_Failure_Reason": [
              "Succeeded"
            ]
          },
          "type": "If"
        },
        "Get_Job_ID": {
          "inputs": "@variables('IdempotencyToken')",
          "runAfter": {
            "Start_Automation_Runbook": [
              "Succeeded"
            ]
          },
          "type": "Compose"
        },
        "Get_Job_Output_And_Errors": {
          "inputs": {
            "authentication": {
              "resource": "https://management.azure.com/",
              "type": "ManagedServiceIdentity"
            },
            "method": "GET",
            "queries": {
              "api-version": "2015-10-31"
            },
            "uri": "https://management.azure.com/subscriptions/74ab10ba-c96d-449e-97cb-ee4f9c0de714/resourceGroups/TradeBot/providers/Microsoft.Automation/automationAccounts/tradebot-automation/jobs/@{encodeURIComponent(outputs('Get_Job_ID'))}/output"
          },
          "runAfter": {
            "Until": [
              "Succeeded"
            ]
          },
          "type": "Http"
        },
        "Get_LogUploader_Key": {
          "inputs": {
            "authentication": {
              "audience": "https://vault.azure.net",
              "type": "ManagedServiceIdentity"
            },
            "method": "GET",
            "uri": "@concat(outputs('Build_KeyVault_BaseUri'), '/secrets/', parameters('logUploaderSecretName'), '?api-version=7.4')"
          },
          "runAfter": {
            "Build_KeyVault_BaseUri": [
              "Succeeded"
            ]
          },
          "type": "Http"
        },
        "Start_Automation_Runbook": {
          "inputs": {
            "authentication": {
              "resource": "https://management.azure.com/",
              "type": "ManagedServiceIdentity"
            },
            "body": {
              "properties": {
                "parameters": "@union(union(createObject('durationMinutes', outputs('Validate_Parameters')['durationMinutes'], 'forceRestart', outputs('Validate_Parameters')['forceRestart'], 'idempotencyToken', variables('IdempotencyToken'), 'imageTag', outputs('Validate_Parameters')['imageTag']), if(not(empty(string(outputs('Validate_Parameters')['debugMode']))), createObject('debugMode', string(outputs('Validate_Parameters')['debugMode'])), json('{}'))), if(not(empty(string(outputs('Validate_Parameters')['logLevel']))), createObject('logLevel', string(outputs('Validate_Parameters')['logLevel'])), json('{}')))",
                "runbook": {
                  "name": "Start-BearishBot-Enhanced"
                }
              }
            },
            "headers": {
              "Content-Type": "application/json"
            },
            "method": "PUT",
            "queries": {
              "api-version": "2015-10-31"
            },
            "uri": "https://management.azure.com/subscriptions/74ab10ba-c96d-449e-97cb-ee4f9c0de714/resourceGroups/TradeBot/providers/Microsoft.Automation/automationAccounts/tradebot-automation/jobs/@{encodeURIComponent(variables('IdempotencyToken'))}"
          },
          "runAfter": {
            "Validate_Parameters": [
              "Succeeded"
            ]
          },
          "type": "Http"
        },
        "Until": {
          "actions": {
            "Delay": {
              "inputs": {
                "interval": {
                  "count": 90,
                  "unit": "Second"
                }
              },
              "type": "Wait"
            },
            "HTTP": {
              "inputs": {
                "authentication": {
                  "type": "ManagedServiceIdentity"
                },
                "body": {
                  "commandId": "RunShellScript",
                  "script": [
                    "status=$(sudo docker inspect -f '{{.State.Status}}' bearish-bot 2>/dev/null || echo 'not_found')",
                    "if [ \"$status\" = \"running\" ]; then",
                    "  echo 'running'",
                    "else",
                    "  echo 'exited'",
                    "fi"
                  ]
                },
                "headers": {
                  "Content-Type": "application/json"
                },
                "method": "POST",
                "uri": "https://management.azure.com/subscriptions/74ab10ba-c96d-449e-97cb-ee4f9c0de714/resourceGroups/TradeBot/providers/Microsoft.Compute/virtualMachines/BearishAlphaBot-VM-01/runCommand?api-version=2023-03-01"
              },
              "runAfter": {
                "Delay": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                }
              },
              "type": "Http"
            },
            "Set_variable": {
              "inputs": {
                "name": "ContainerStatus",
                "value": "@if(equals(actions('HTTP')?['status'], 'Succeeded'), trim(split(split(body('HTTP')?['value']?[0]?['message'], '[stdout]')[1], '[stderr]')[0]), 'error')"
              },
              "runAfter": {
                "HTTP": [
                  "Succeeded",
                  "TimedOut",
                  "Skipped",
                  "Failed"
                ]
              },
              "type": "SetVariable"
            }
          },
          "expression": "@or(equals(variables('ContainerStatus'), 'exited'), equals(variables('ContainerStatus'), 'error'))",
          "limit": {
            "count": 400,
            "timeout": "PT8H"
          },
          "runAfter": {
            "Check_Startup_Success": [
              "Succeeded"
            ]
          },
          "type": "Until"
        },
        "Validate_Parameters": {
          "inputs": {
            "debugMode": "@triggerBody()?['debugMode']",
            "durationMinutes": "@coalesce(triggerBody()?['durationMinutes'], 60)",
            "forceRestart": "@coalesce(triggerBody()?['forceRestart'], false)",
            "imageTag": "@coalesce(triggerBody()?['imageTag'], 'vm-vmboot-12')",
            "logLevel": "@triggerBody()?['logLevel']"
          },
          "runAfter": {
            "Get_LogUploader_Key": [
              "Succeeded"
            ]
          },
          "type": "Compose"
        },
        "Wait_For_Job_Completion": {
          "actions": {
            "Delay_30_Seconds": {
              "inputs": {
                "interval": {
                  "count": 30,
                  "unit": "Second"
                }
              },
              "runAfter": {
                "Get_Job_Status": [
                  "Succeeded"
                ]
              },
              "type": "Wait"
            },
            "Get_Job_Status": {
              "inputs": {
                "authentication": {
                  "resource": "https://management.azure.com/",
                  "type": "ManagedServiceIdentity"
                },
                "method": "GET",
                "queries": {
                  "api-version": "2015-10-31"
                },
                "uri": "https://management.azure.com/subscriptions/74ab10ba-c96d-449e-97cb-ee4f9c0de714/resourceGroups/TradeBot/providers/Microsoft.Automation/automationAccounts/tradebot-automation/jobs/@{encodeURIComponent(outputs('Get_Job_ID'))}"
              },
              "type": "Http"
            }
          },
          "expression": "@or(equals(body('Get_Job_Status')?['properties']?['status'], 'Completed'), equals(body('Get_Job_Status')?['properties']?['status'], 'Failed'), equals(body('Get_Job_Status')?['properties']?['status'], 'Stopped'), equals(body('Get_Job_Status')?['properties']?['status'], 'Suspended'))",
          "limit": {
            "count": 20,
            "timeout": "PT10M"
          },
          "runAfter": {
            "Get_Job_ID": [
              "Succeeded"
            ]
          },
          "type": "Until"
        }
      },
      "runAfter": {
        "Initialize_Container_Status": [
          "Succeeded"
        ]
      },
      "type": "Scope"
    },
    "Send_Global_Error_Email": {
      "inputs": {
        "body": {
          "content": {
            "html": "<p class=\"editor-paragraph\">Merhaba,<br><br>'bearish-bot-orchestrator' i aknda beklenmedik bir hata olutu ve ilem tamamlanamad.<br><br>Hata Detay: Ana ilem kapsam (Main Scope) baarsz oldu.<br><br>Run ID: @{workflow().run.name}<br><br>Hatal adm grmek iin altrma gemiini kontrol ediniz:<br>https://portal.azure.com/#resource@{workflow().id}/history<br><br>Tarih: @{utcNow()}</p>",
            "subject": " KRTK: Logic App Beklenmedik ekilde Durdu"
          },
          "importance": "Normal",
          "recipients": {
            "to": [
              {
                "address": "@parameters('notification_recipient_email')"
              }
            ]
          },
          "senderAddress": "@parameters('sender_email_address')"
        },
        "host": {
          "connection": {
            "name": "@parameters('$connections')['acsemail-3']['connectionId']"
          }
        },
        "method": "post",
        "path": "/emails:sendGAVersion",
        "queries": {
          "api-version": "2023-03-31"
        }
      },
      "runAfter": {
        "Main_Try_Scope": [
          "TimedOut",
          "Skipped",
          "Failed"
        ]
      },
      "type": "ApiConnection"
    },
    "Send_Initial_Response": {
      "inputs": {
        "body": {
          "message": "Bot workflow started successfully",
          "runId": "@{workflow().run.name}",
          "status": "accepted",
          "timestamp": "@{utcNow()}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "statusCode": 202
      },
      "kind": "Http",
      "runAfter": {},
      "type": "Response"
    }
  },
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "keyVaultName": {
      "type": "String"
    },
    "logUploaderSecretName": {
      "type": "String"
    },
    "log_uploader_function_url": {
      "type": "String"
    },
    "notification_recipient_email": {
      "type": "String"
    },
    "sender_email_address": {
      "defaultValue": "DoNotReply@dedf8228-9b97-4d99-a4a8-12ea32134c1c.azurecomm.net",
      "type": "String"
    }
  },
  "triggers": {
    "manual": {
      "inputs": {
        "schema": {
          "properties": {
            "durationMinutes": {
              "description": "Trading session duration in minutes",
              "maximum": 420,
              "minimum": 1,
              "type": "integer"
            },
            "forceRestart": {
              "default": false,
              "description": "Force restart even if bot is already running",
              "type": "boolean"
            },
            "imageTag": {
